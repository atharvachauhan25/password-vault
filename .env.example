# Flask secret key for session signing.
# If not set, a random key is generated at startup (sessions won't persist across restarts).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Inactivity timeout in seconds (default: 300 = 5 minutes)
INACTIVITY_TIMEOUT=300

# Clipboard auto-clear timeout in seconds (default: 30)
CLIPBOARD_CLEAR_SECONDS=30
