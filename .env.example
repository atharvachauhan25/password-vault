# Flask secret key for session signing.
# If not set, a random key is generated at startup (sessions won't persist across restarts).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Development only: set to 1 to enable the Flask debugger. Never enable for real use.
FLASK_DEBUG=0

# Inactivity timeout in seconds (default: 300 = 5 minutes)
INACTIVITY_TIMEOUT=300

# Clipboard auto-clear timeout in seconds (default: 30)
CLIPBOARD_CLEAR_SECONDS=30

# Brute-force protection: max failed unlock attempts before cooldown (default: 5)
MAX_UNLOCK_ATTEMPTS=5

# Cooldown duration in seconds after max failed attempts (default: 30)
UNLOCK_COOLDOWN_SECONDS=30
